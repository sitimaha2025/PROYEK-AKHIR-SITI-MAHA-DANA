>aspect(1.5); plot2d("(x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18)",0,4); plot2d(3,-4/5,>points,style="ow",>add):

>$showev('limit(2*x*sin(x)/(1-cos(x)),x,0))
