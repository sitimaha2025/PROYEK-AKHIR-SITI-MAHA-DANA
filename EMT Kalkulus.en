>integrate("exp(-x^2)", 0, 2)
>plot2d("exp(-x^2)", -0.5, 2.5); x_ar=linspace(0,2,100); plot2d(x_ar, exp(-x_ar^2), >filled, style="|", fillcolor=green, >add):

