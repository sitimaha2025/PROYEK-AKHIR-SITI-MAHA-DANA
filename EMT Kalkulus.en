** Latihan 4C: Empat Representasi Kurva & Kurvatur (Kelengkungan)
% Kurva pilihan: Kurva Katenari y = cosh(x)
% a. Kartesius: y = cosh(x)
>function y_kart(x) &= cosh(x)
>function k_kart(x) &= trigsimp(diff(y_kart(x), x, 2)/(1 + diff(y_kart(x), x)^2)^(3/2)); $'k_kart(x)=k_kart(x)

% c. Parametrik: x(t) = t, y(t) = cosh(t)
>function xp(t) &= t; function yp(t) &= cosh(t);
>function k_param(t) &= trigsimp((diff(xp(t),t)*diff(yp(t),t,2) - diff(xp(t),t,2)*diff(yp(t),t))/(diff(xp(t),t)^2 + diff(yp(t),t)^2)^(3/2)); $'k_param(t)=k_param(t)

% d. Implisit: F(x, y) = cosh(x) - y = 0
>function F_imp(x, y) &= cosh(x) - y;
>Fx &= diff(F_imp(x,y), x); Fxx &= diff(F_imp(x,y), x, 2);
>Fy &= diff(F_imp(x,y), y); Fyy &= diff(F_imp(x,y), y, 2); Fxy &= diff(diff(F_imp(x,y), x), y);
>function k_imp(x) &= trigsimp((Fy^2*Fxx - 2*Fx*Fy*Fxy + Fx^2*Fyy)/(Fx^2 + Fy^2)^(3/2)); $'k_imp(x)=k_imp(x)

% b. Koordinat Kutub (Spiral Logaritmik r(theta) = exp(theta)):
>function r_kut(th) &= exp(th);
>function k_kut(th) &= radcan((r_kut(th)^2 + 2*diff(r_kut(th),th)^2 - r_kut(th)*diff(r_kut(th),th,2))/(r_kut(th)^2 + diff(r_kut(th),th)^2)^(3/2)); $'k_kut(th)=k_kut(th)

% Plot Katenari y = cosh(x), kurva kurvatur k(x), radius kelengkungan 1/k(x), dan lingkaran oskulasi di puncak (0, 1):
% Di x = 0: y(0) = 1, k(0) = 1, radius R = 1, sehingga pusat lingkaran oskulasi di (0, 2).
>plot2d(["cosh(x)", "1/cosh(x)^2"], -2, 2, color=[blue, red]);
>plot2d("cosh(x)^2", -1.2, 1.2, color=green, >add);
>plot2d("cos(x)", "2 + sin(x)", xmin=0, xmax=2*pi, color=magenta, >add, title="Katenari, Kurvatur, Radius, & Lingkaran Oskulasi"):

* Barisan dan Deret
% Contoh perhitungan barisan, iterasi, dan deret tak hingga dengan EMT dan Maxima.
>1:10 // barisan sederhana
>q=1.05; iterate("x*q",1000,n=10)' // pertumbuhan 5% selama 10 periode
>sequence("x[n-1]+x[n-2]",[1,1],15) // barisan Fibonacci
>iterate("cos(x)",1) // iterasi titik tetap x = cos(x)
>iterate("(x+2/x)/2",2) // metode Newton untuk akar(2)

% Deret Taylor dan Jumlah Deret Tak Hingga:
>$'sum(k,k,1,n) = factor(ev(sum(k,k,1,n),simpsum=true))
>$'sum(1/x^2,x,1,inf) = ev(sum(1/x^2,x,1,inf),simpsum=true)
>&assume(abs(x)<1); $'sum(a*x^k,k,0,inf) = ev(sum(a*x^k,k,0,inf),simpsum=true); &forget(abs(x)<1)
>$'e^x = taylor(exp(x),x,0,10)
>$'log(x) = taylor(log(x),x,1,10)
>
