* Turunan Fungsi
% Definisi turunan: f'(x) = lim_{h->0} (f(x+h) - f(x)) / h
>$showev('limit(((x+h)^n-x^n)/h,h,0)) // turunan x^n
% Penjelasan Matematis (Teorema Binomial):
% Berdasarkan ekspansi binomial, (x+h)^n = x^n + n*x^(n-1)*h + [n(n-1)/2]*x^(n-2)*h^2 + ... + h^n.
% Jika dikurangi x^n lalu dibagi h, diperoleh: n*x^(n-1) + [n(n-1)/2]*x^(n-2)*h + ... + h^(n-1).
% Saat h -> 0, seluruh suku yang masih memuat h bernilai 0, sehingga tersisa n*x^(n-1).
>$showev('limit((sin(x+h)-sin(x))/h,h,0)) // turunan sin(x)
% Penjelasan Matematis (Rumus Jumlah Dua Sudut):
% Menggunakan identitas sin(x+h) = sin(x)cos(h) + cos(x)sin(h), bentuk limit menjadi:
% lim_{h->0} [sin(x)(cos(h)-1)/h + cos(x)(sin(h)/h)].
% Karena lim_{h->0} (cos(h)-1)/h = 0 dan lim_{h->0} sin(h)/h = 1, hasilnya adalah cos(x).
>$showev('limit((log(x+h)-log(x))/h,h,0)) // turunan log(x)
% Penjelasan Matematis (Sifat Logaritma):
% Menggunakan sifat log(x+h) - log(x) = log((x+h)/x) = log(1 + h/x), bentuk limit menjadi:
% lim_{h->0} (1/h)*log(1 + h/x) = lim_{h->0} log((1 + h/x)^(1/h)).
% Misalkan u = h/x, saat h -> 0 maka u -> 0 dan 1/h = 1/(u*x), sehingga diperoleh:
% (1/x)*log(lim_{u->0} (1 + u)^(1/u)) = (1/x)*log(e) = 1/x.
>$showev('limit((1/(x+h)-1/x)/h,h,0)) // turunan 1/x
>$showev('limit(factor((E^(x+h)-E^x)/h),h,0)) // turunan e^x

>function f(x) &= x^x
>&assume(x>0); $showev('limit((f(x+h)-f(x))/h,h,0)) // turunan x^x
>&forget(x>0) // menghapus asumsi agar kembali ke pengaturan awal

>function f(x) &= sinh(x)
>function df(x) &= limit((f(x+h)-f(x))/h,h,0); $df(x)
>plot2d(["f(x)","df(x)"],-pi,pi,color=[blue,red]):

>function f(x) &= sin(3*x^5+7)^2
>diff(f,3), diffc(f,3)
% Perbedaan diff dan diffc:
% - diff(f, x) menghitung turunan numerik menggunakan selisih maju/mundur standar.
% - diffc(f, x) menghitung turunan numerik menggunakan selisih pusat (central difference),
%   yakni [f(x+h) - f(x-h)] / (2h), yang umumnya memiliki galat lebih kecil (lebih akurat).
% 1. Fungsi Polinomial: p1(x) = 2*x^3 - 5*x + 3
>function p1(x) &= 2*x^3 - 5*x + 3
>function dp1(x) &= limit((p1(x+h) - p1(x))/h, h, 0); $dp1(x)
>plot2d(["p1(x)", "dp1(x)"], -2, 2, color=[blue, red], title="Polinomial & Turunannya"):

% 2. Fungsi Rasional: p2(x) = (x - 1)/(x + 2)
>function p2(x) &= (x - 1)/(x + 2)
>function dp2(x) &= ratsimp(limit((p2(x+h) - p2(x))/h, h, 0)); $dp2(x)
>plot2d(["p2(x)", "dp2(x)"], -1, 5, color=[blue, red], title="Rasional & Turunannya"):

% 3. Fungsi Trigonometri: p3(x) = cos(2*x) + sin(x)
>function p3(x) &= cos(2*x) + sin(x)
>function dp3(x) &= limit((p3(x+h) - p3(x))/h, h, 0); $dp3(x)
>plot2d(["p3(x)", "dp3(x)"], -pi, pi, color=[blue, red], title="Trigonometri & Turunannya"):

% 4. Fungsi Eksponensial: p4(x) = exp(2*x)
>function p4(x) &= exp(2*x)
>function dp4(x) &= limit(factor((p4(x+h) - p4(x))/h), h, 0); $dp4(x)
>plot2d(["p4(x)", "dp4(x)"], -1.5, 1.5, color=[blue, red], title="Eksponensial & Turunannya"):

% 5. Fungsi Akar (Irasional): p5(x) = sqrt(x + 3)
>function p5(x) &= sqrt(x + 3)
>&assume(x > -3);
>function dp5(x) &= limit((p5(x+h) - p5(x))/h, h, 0); $dp5(x)
>&forget(x > -3);
>plot2d(["p5(x)", "dp5(x)"], -2.5, 5, color=[blue, red], title="Fungsi Akar & Turunannya"):

* Integral dan Aplikasinya
% Integral tak tentu dan integral tentu menggunakan fungsi Maxima "integrate".
>$showev('integrate(1/(1+x^2),x))
>$showev('integrate(sin(x),x,0,pi))
>$showev('integrate(x*exp(-x),x,0,1))

** Latihan 4A: Integral 5 Fungsi Integrabel & 3 Fungsi Non-Integrabel Elementer
% --- Bagian 1: 5 Fungsi yang Memiliki Antiturunan ---
% 1. Polinomial: int(3*x^2 - 4*x + 2, x, 0, 3)
>$showev('integrate(3*x^2 - 4*x + 2, x))
>$showev('integrate(3*x^2 - 4*x + 2, x, 0, 3))
>plot2d("3*x^2 - 4*x + 2", -0.5, 3.5); x_ar=linspace(0,3,100); plot2d(x_ar, 3*x_ar^2-4*x_ar+2, >filled, style="/", fillcolor=green, >add):

% 2. Rasional: int(4/(1 + x^2), x, 0, 1)
>$showev('integrate(4/(1 + x^2), x))
>$showev('integrate(4/(1 + x^2), x, 0, 1))
>plot2d("4/(1 + x^2)", -0.5, 1.5); x_ar=linspace(0,1,100); plot2d(x_ar, 4/(1+x_ar^2), >filled, style="/", fillcolor=cyan, >add):

% 3. Trigonometri: int(sin(x)*cos(x), x, 0, pi/2)
>$showev('integrate(sin(x)*cos(x), x))
>$showev('integrate(sin(x)*cos(x), x, 0, pi/2))
>plot2d("sin(x)*cos(x)", 0, pi); x_ar=linspace(0,pi/2,100); plot2d(x_ar, sin(x_ar)*cos(x_ar), >filled, style="/", fillcolor=yellow, >add):

% 4. Eksponensial: int(2*exp(-x), x, 0, 2)
>$showev('integrate(2*exp(-x), x))
>$showev('integrate(2*exp(-x), x, 0, 2))
>plot2d("2*exp(-x)", -0.2, 2.5); x_ar=linspace(0,2,100); plot2d(x_ar, 2*exp(-x_ar), >filled, style="/", fillcolor=orange, >add):

% 5. Logaritma (Integral Parsial): int(log(x), x, 1, exp(1))
>$showev('integrate(log(x), x))
>$showev('integrate(log(x), x, 1, exp(1)))
>plot2d("log(x)", 0.5, 3); x_ar=linspace(1,exp(1),100); plot2d(x_ar, log(x_ar), >filled, style="/", fillcolor=magenta, >add):

% --- Bagian 2: 3 Fungsi yang Tidak Dapat Diintegralkan Secara Elementer (Numerik) ---
